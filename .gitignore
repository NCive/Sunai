# =====================================================================
# Sunai Voice Assistant .gitignore
# =====================================================================

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
secrets/

# Audio and audio cache
Backend/audio_cache/**
!Backend/audio_cache/.gitkeep
/audio_cache/
tests/samples/
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.webm

# Large model weights, checkpoints & HuggingFace caches
Models/
/Models/
hub/
snapshots/
hf_cache/
*.gguf
*.safetensors
*.bin
*.onnx
*.wasm
Frontend/public/vad/
*.pt
*.pth
*.ckpt

# Runtime logs, indices & metrics data
/logs/
Backend/logs/**
!Backend/logs/.gitkeep

# Python virtual environments, packaging & bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/

# Testing & Pytest artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Scratch benchmarks & temporary benchmark experiments
scratch_benchmark/
scratch_benchmarks/
scratch/
.scratch/

# LLM testing & benchmark results (explicitly preserved in GitHub repo)
!LLM_Testing/
!LLM_Testing/results/
!LLM_Testing/results/**

# Node, web app dependencies and build outputs
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
*.tsbuildinfo

# OS, IDE & Editor metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp
