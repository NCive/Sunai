# =====================================================================
# Sunai Voice Assistant - Environment Configuration Example
# Copy this file to .env and configure your environment.
# =====================================================================

# ---------------------------------------------------------------------
# Gnani Cloud API Credentials & Endpoints
# ---------------------------------------------------------------------
# API key for Gnani.ai cloud services (Prisma STT v3.0 & Timbre TTS v2.5)
GNANI_API_KEY=your_gnani_api_key_here

# Gnani Token URL for authenticating STT WebSocket sessions
GNANI_TOKEN_URL=https://token.gnani.ai/token

# Gnani Prisma ASR WebSocket streaming endpoint
GNANI_ASR_WS_URL=wss://asr.gnani.ai/listen

# Gnani Timbre TTS HTTP synthesis endpoint
GNANI_TTS_HTTP_URL=https://tts.gnani.ai/synthesize

# ---------------------------------------------------------------------
# Local LLM / llama.cpp Configuration (Qwen3.5-4B-Instruct)
# ---------------------------------------------------------------------
# Base URL of the running llama-server instance
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Path to the llama-server executable binary
LLAMA_SERVER_BIN=llama-server

# Absolute or relative path to the Qwen3.5-4B GGUF model file
QWEN_GGUF_MODEL_PATH=Models/hub/models--unsloth--Qwen3.5-4B-GGUF/snapshots/e87f176479d0855a907a41277aca2f8ee7a09523/Qwen3.5-4B-UD-Q5_K_XL.gguf

# Context window size in tokens for llama-server
LLM_CTX_SIZE=1024

# Number of CPU threads to allocate for llama-server inference
LLM_N_THREADS=8

# Number of layers to offload to GPU (set > 0 if CUDA/Vulkan GPU is available)
LLM_N_GPU_LAYERS=0

# ---------------------------------------------------------------------
# Paths & Documents Configuration
# ---------------------------------------------------------------------
# Directory containing top-level knowledge base documents (.md and .txt) for RAG
SUNAI_DOCS_DIR=docs

# Path to pre-warmed MiniLM sentence transformer model
MINILM_MODEL_PATH=Models/hub/models--sentence-transformers--all-MiniLM-L6-v2/snapshots/1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Directory for storing pre-recorded and synthesized audio cache clips (.wav)
SUNAI_AUDIO_CACHE_DIR=Backend/audio_cache

# Path to JSON-lines metrics log file
SUNAI_METRICS_LOG=Backend/logs/metrics.jsonl

# Directory for application logs and metrics
SUNAI_METRICS_LOG_DIR=Backend/logs

# ---------------------------------------------------------------------
# Server & Network Settings
# ---------------------------------------------------------------------
# Host address to bind the Sunai FastAPI WebSocket server (0.0.0.0 for all interfaces)
SUNAI_HOST=0.0.0.0

# Port number for the Sunai FastAPI WebSocket server
SUNAI_PORT=8000

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
SUNAI_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Development & Testing Flags
# ---------------------------------------------------------------------
# Enable mock Gnani services for offline/test environments without an API key (true/false)
SUNAI_MOCK_GNANI=false

# Default turn-taking mode: "pause_first" (innovative zero-overlap) or "baseline" (naive barge-in)
SUNAI_MODE_DEFAULT=pause_first
